# Copy to server/.env (git-ignored) and fill in.
# Leave MONGODB_URI unset to run on an in-memory MongoDB that is re-seeded on
# every start (fine for development).
# Atlas form: mongodb+srv://<user>:<password>@<cluster-host>/xorvest?retryWrites=true&w=majority&appName=Xorvest
MONGODB_URI=mongodb://127.0.0.1:27017/xorvest
PORT=5050
CLIENT_ORIGIN=http://localhost:5173
